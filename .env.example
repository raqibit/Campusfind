# CampusFind web client
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Express API
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/campusfind
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# Required only when running the seed command. Use a private value of at least 12 characters.
SEED_ADMIN_PASSWORD=

# Optional image-embedding provider. Leave empty to use metadata matching only.
IMAGE_EMBEDDING_API_URL=
IMAGE_EMBEDDING_API_KEY=

# Optional local MinIO service (used by docker-compose.minio.yml). Generate local-only values.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Optional S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, etc.).
# Keep the bucket private. Report photos are delivered through short-lived signed GET URLs;
# claim evidence is only signed by the authenticated admin evidence endpoint.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=true
