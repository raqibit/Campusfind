# CampusFind web client
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Express API
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/campusfind
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# Required only when running the seed command. Use a private value of at least 12 characters.
SEED_ADMIN_PASSWORD=

# Optional image-embedding provider. Leave empty to use metadata matching only.
IMAGE_EMBEDDING_API_URL=
IMAGE_EMBEDDING_API_KEY=

# Optional OpenAI text embeddings (server-side only; never use a NEXT_PUBLIC_ prefix)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_VISION_MODEL=gpt-4o-mini

# Private S3-compatible storage (local MinIO by default)
API_PUBLIC_URL=http://localhost:5000
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=campusfind
S3_ACCESS_KEY_ID=campusfind
S3_SECRET_ACCESS_KEY=change-this-local-minio-secret

# Email verification and password reset (configure a real mail relay for production)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.edu

# Google and Apple web sign-in. Register exact callback URLs under API_PUBLIC_URL.
AUTH_CALLBACK_URL=http://localhost:5000/api/auth/oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
AUTH_COOKIE_SAME_SITE=lax
